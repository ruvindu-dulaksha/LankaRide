rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profile documents
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Driver outcomes written from map feedback flow
    match /driver_outcomes/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.driver_id == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.driver_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Hotspot visits written from driver feedback services
    match /hotspot_visits/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.driver_id == request.auth.uid;
      allow read: if isSignedIn()
        && resource.data.driver_id == request.auth.uid;
      allow update, delete: if false;
    }

    // Aggregate hotspot stats
    // Client currently updates these docs; keep auth-required write for now.
    match /hotspot_stats/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
